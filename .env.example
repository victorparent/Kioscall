# Copy this file to .env and fill in your own key. .env is git-ignored.
# Server-side only (read by src/app/api/news+api.ts): never prefix it with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional: model used to group articles into topics (default: claude-haiku-5-5, about $1/day at most).
# More capable but pricier:
# NEWS_GROUPING_MODEL=claude-opus-5-5

# Optional, native builds only: URL of the deployed server (to get the AI grouping on a phone).
# EXPO_PUBLIC_API_URL=https://your-server.example.com
